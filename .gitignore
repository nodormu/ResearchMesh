.env
__pycache__
.venv
.DS_Store
# Claude Code editor config — not part of the app. This project uses the
# anthropic Client SDK directly (core/claude.py), NOT the Claude Agent SDK,
# so nothing here is needed to run or use the project.
.claude/

# The `memory` tool's store (core/memory.py, CLAUDE_MEMORY_DIR). Claude's own
# notes to itself across sessions — local state, not source.
memories/

# Personal brainstorming notes — not part of the project
node_modules/

# Machine-local convenience scripts (e.g. cross-repo fork-parity checks
# against sibling ResearchMesh-Router/-Mac/-Windows clones that only exist
# on this one machine). Not part of the shipped project — a fresh clone
# has none of those sibling repos, so scripts assuming they exist would
# just confuse/break for anyone else. Kept out of git entirely rather
# than shipped-but-inert.
scripts/
